// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  isVerified   Boolean       @default(false)
  verifyCode       String?
  verifyCodeExpiry DateTime?
  verifyAttempts   Int       @default(0)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt    DateTime      @default(now())
  screenings   Screening[]
  assessments  Assessment[]
  emergencyContacts EmergencyContact[]
  weeklyAnalysis WeeklyAnalyis[]
  alertEvents AlertEvents[]
}

model Screening {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  audioUrl            String
  conditionLabel      String
  conditionConfidence Float
  causeLabel          String
  causeConfidence     Float
  transcript          String?
  createdAt           DateTime @default(now())
  conditionScores     Json
  causeScores         Json
  Keywords            Json

  @@index([userId, createdAt])
}

model Assessment {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  combinedAudioUrl String?
  totalDuration Float
  // Legacy field — kept for backward compatibility
  prediction    String?
  confidence    Float?
  transcript    String?
  // Condition (Head 1) results from Phase 4 model
  conditionLabel      String?
  conditionConfidence Float?
  conditionScores     Json?
  // Cause (Head 2) results from Phase 4 model
  causeLabel          String?
  causeConfidence     Float?
  causeScores         Json?
  // Depression (Phase 6 fusion) — placeholder for now
  depressionPrediction String?
  depressionConfidence Float?
  createdAt     DateTime              @default(now())
  responses     AssessmentResponse[]
  keywords      Json

  @@index([userId,createdAt])
}


model AssessmentResponse {
  id               String     @id @default(uuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id])
  questionId       String
  category         String
  questionText     String
  audioUrl         String
  duration         Float
  timestamp        DateTime
  hadFollowUp      Boolean    @default(false)
  followUpText     String?
  followUpAudioUrl String?
  followUpDuration Float?
}

